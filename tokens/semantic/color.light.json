{
  "color": {
    "bg": {
      "$type": "color",
      "$description": "page background",
      "$value": "{color.paper.100}"
    },
    "bg-subtle": {
      "$type": "color",
      "$description": "alternate section background",
      "$value": "{color.paper.200}"
    },
    "surface": {
      "$type": "color",
      "$description": "cards, panels, form fields",
      "$value": "{color.paper.50}"
    },
    "text": {
      "$type": "color",
      "$description": "primary text, headings",
      "$value": "{color.ink.900}"
    },
    "text-secondary": {
      "$type": "color",
      "$description": "body copy on subtle backgrounds",
      "$value": "{color.ink.700}"
    },
    "text-muted": {
      "$type": "color",
      "$description": "labels, captions, metadata",
      "$value": "{color.ink.500}"
    },
    "border": {
      "$type": "color",
      "$description": "hairlines, dividers (decorative)",
      "$value": "{color.paper.300}"
    },
    "border-strong": {
      "$type": "color",
      "$description": "emphasised rules (decorative; not for control outlines)",
      "$value": "{color.paper.400}"
    },
    "border-control": {
      "$type": "color",
      "$description": "outlines of form controls and other UI that must be seen (3:1)",
      "$value": "{color.paper.600}"
    },
    "grid-line": {
      "$type": "color",
      "$description": "drafting-grid background lines",
      "$value": "{color.ink.900}",
      "$extensions": {
        "in.manjunathhk": {
          "alpha": 0.05
        }
      }
    },
    "accent": {
      "$type": "color",
      "$description": "links, highlights, primary actions",
      "$value": "{color.denim.600}"
    },
    "on-accent": {
      "$type": "color",
      "$description": "text or icons on accent fills",
      "$value": "{color.white}"
    },
    "accent-subtle": {
      "$type": "color",
      "$description": "tinted backgrounds; accent at 13% alpha",
      "$value": "{color.denim.600}",
      "$extensions": {
        "in.manjunathhk": {
          "alpha": 0.13
        }
      }
    },
    "danger": {
      "$type": "color",
      "$description": "errors",
      "$value": "{color.red.600}"
    },
    "success": {
      "$type": "color",
      "$description": "success states",
      "$value": "{color.green.700}"
    },
    "warning": {
      "$type": "color",
      "$description": "warnings",
      "$value": "{color.amber.700}"
    },
    "focus-ring": {
      "$type": "color",
      "$description": "focus outline; same as accent",
      "$value": "{color.denim.600}"
    }
  }
}
