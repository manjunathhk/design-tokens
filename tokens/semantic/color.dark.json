{
  "color": {
    "bg": {
      "$type": "color",
      "$description": "page background",
      "$value": "{color.stone.950}"
    },
    "bg-subtle": {
      "$type": "color",
      "$description": "alternate section background",
      "$value": "{color.stone.900}"
    },
    "surface": {
      "$type": "color",
      "$description": "cards, panels, form fields",
      "$value": "{color.stone.800}"
    },
    "text": {
      "$type": "color",
      "$description": "primary text, headings",
      "$value": "{color.stone.50}"
    },
    "text-secondary": {
      "$type": "color",
      "$description": "body copy on subtle backgrounds",
      "$value": "{color.stone.300}"
    },
    "text-muted": {
      "$type": "color",
      "$description": "labels, captions, metadata",
      "$value": "{color.stone.400}"
    },
    "border": {
      "$type": "color",
      "$description": "hairlines, dividers (decorative)",
      "$value": "{color.stone.700}"
    },
    "border-strong": {
      "$type": "color",
      "$description": "emphasised rules (decorative; not for control outlines)",
      "$value": "{color.stone.500}"
    },
    "border-control": {
      "$type": "color",
      "$description": "outlines of form controls and other UI that must be seen (3:1)",
      "$value": "{color.stone.500}"
    },
    "grid-line": {
      "$type": "color",
      "$description": "drafting-grid background lines",
      "$value": "{color.white}",
      "$extensions": {
        "in.manjunathhk": {
          "alpha": 0.04
        }
      }
    },
    "accent": {
      "$type": "color",
      "$description": "links, highlights, primary actions",
      "$value": "{color.amber.400}"
    },
    "on-accent": {
      "$type": "color",
      "$description": "text or icons on accent fills",
      "$value": "{color.stone.900}"
    },
    "accent-subtle": {
      "$type": "color",
      "$description": "tinted backgrounds; accent at 14% alpha",
      "$value": "{color.amber.400}",
      "$extensions": {
        "in.manjunathhk": {
          "alpha": 0.14
        }
      }
    },
    "danger": {
      "$type": "color",
      "$description": "errors",
      "$value": "{color.red.400}"
    },
    "success": {
      "$type": "color",
      "$description": "success states",
      "$value": "{color.green.400}"
    },
    "warning": {
      "$type": "color",
      "$description": "warnings",
      "$value": "{color.orange.400}"
    },
    "info": {
      "$type": "color",
      "$description": "informational messages",
      "$value": "{color.blue.400}"
    },
    "focus-ring": {
      "$type": "color",
      "$description": "focus outline; same as accent",
      "$value": "{color.amber.400}"
    }
  }
}
