  --mk-spacing-12: 48px;
  --mk-spacing-16: 64px;
  --mk-spacing-20: 80px;
  --mk-spacing-24: 96px;
  --mk-spacing-32: 128px;
  --mk-z-index-nav: 50;
  --mk-z-index-overlay: 80;
  --mk-z-index-toast: 90;
  color-scheme: light;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --mk-color-accent: #C39E88;
    --mk-color-accent-subtle: rgba(195, 158, 136, 0.13);
    --mk-color-bg: #2D2521;
    --mk-color-bg-subtle: #1F1A17;
    --mk-color-border: #534D49;
    --mk-color-border-control: #C39E88;
    --mk-color-border-strong: #7F6A5F;
    --mk-color-danger: #FF8A7A;
    --mk-color-focus-ring: #C39E88;
    --mk-color-grid-line: rgba(241, 240, 229, 0.05);
    --mk-color-on-accent: #2D2521;
    --mk-color-success: #86C99A;
    --mk-color-surface: #3C332E;
    --mk-color-text: #F1F0E5;
    --mk-color-text-muted: #AE998C;
    --mk-color-text-secondary: #D9C7BB;
    --mk-color-warning: #F0B860;
    color-scheme: dark;
  }
}

:root[data-theme="dark"] {
  --mk-color-accent: #C39E88;
  --mk-color-accent-subtle: rgba(195, 158, 136, 0.13);
  --mk-color-bg: #2D2521;
  --mk-color-bg-subtle: #1F1A17;
  --mk-color-border: #534D49;
  --mk-color-border-control: #C39E88;
  --mk-color-border-strong: #7F6A5F;
