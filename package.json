{
  "name": "@manjunathhk/design-tokens",
  "version": "0.0.0",
  "description": "Design tokens and a small opt-in base stylesheet shared by Manjunath's websites.",
  "license": "MIT",
  "author": "Manjunath Krishnasa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manjunathhk/design-tokens.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && stylelint \"src/**/*.css\" --allow-empty-input && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api-diff": "tsx scripts/api-diff.ts",
    "build": "tsx src/build.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "style-dictionary": "^4.4.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
