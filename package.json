{
  "name": "@manjunathhk/design-tokens",
  "version": "0.0.0",
  "description": "Design tokens and a small opt-in base stylesheet shared by Manjunath's websites.",
  "license": "MIT",
  "author": "Manjunath Krishnasa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manjunathhk/design-tokens.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "style": "dist/index.css",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "style": "./dist/index.css",
      "default": "./dist/tokens.mjs"
    },
    "./index.css": "./dist/index.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./dist/tokens.json",
    "./tokens.mjs": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.mjs"
    },
    "./_tokens.scss": "./dist/_tokens.scss",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && stylelint \"src/**/*.css\" --allow-empty-input && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api-diff": "tsx scripts/api-diff.ts",
    "build": "tsx src/build.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "@ibm/plex-sans-condensed": "2.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "style-dictionary": "^5.5.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
